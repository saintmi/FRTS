{
  "name": "frts-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FRTS Learning Platform - React + TypeScript + Vite + Neon PostgreSQL",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0 || true",
